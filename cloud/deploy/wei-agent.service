[Unit]
Description=Wei AI Agent
After=network.target docker.service
Requires=docker.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/wei/cloud
EnvironmentFile=/opt/wei/cloud/.env
ExecStart=/opt/wei/cloud/deploy/start_server.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
