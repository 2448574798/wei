# Server HTTP
APP_HOST=127.0.0.1
APP_PORT=8000

# Model gateway
ONE_API_URL=http://127.0.0.1:3000/v1
ONE_API_TOKEN=replace-with-real-token

# Model routing
DISPATCHER_MODEL=gpt-4o-mini
EXECUTION_MODEL_SIMPLE=gpt-4o-mini
EXECUTION_MODEL_STANDARD=gpt-4o
EXECUTION_MODEL_ADVANCED=gpt-5.4
LOCAL_EXECUTION_MODEL=gpt-5.4
ONLINE_RESEARCH_MODEL=gpt-4o-mini-search-preview
ONLINE_RESEARCH_MAX_TOKENS=420

# Optional local tool endpoints consumed by the server.
# Browser/Profile/MCP launch details now belong in local_launcher/.env.
OPEN_INTERPRETER_URL=http://127.0.0.1:18000
OPEN_INTERPRETER_AUTH_KEY=dummy-api-key
OPEN_INTERPRETER_MODEL=open-interpreter
OPEN_INTERPRETER_TIMEOUT=90

BROWSER_BRIDGE_URL=http://127.0.0.1:18100
BROWSER_BRIDGE_TOKEN=browser-bridge-local-token
BROWSER_BRIDGE_TIMEOUT=60

# Optional websocket worker path for cloud -> local browser orchestration.
# Enable this on the server when a local thin browser worker will connect back.
BROWSER_WORKER_ENABLED=false
BROWSER_WORKER_DEFAULT_ID=default
BROWSER_WORKER_TOKEN=replace-with-browser-worker-token
BROWSER_WORKER_REQUEST_TIMEOUT=60

# Infra
# Local dev default: keep Redis on the server side and forward it through SSH.
# Example:
#   ssh -N -L 6380:127.0.0.1:6379 ubuntu@43.134.7.123
REDIS_URL=redis://127.0.0.1:6380/0

SEARXNG_URL=http://127.0.0.1:8888
FETCH_TEXT_LIMIT=3000
SEARCH_RESULT_LIMIT=5

# Auth
AUTH_DB_PATH=/opt/wei/data/wei_auth.db
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-real-admin-password
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_COOKIE_NAME=wei_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=7
AUTH_PBKDF2_ITERATIONS=200000

# Files and logs
SYSTEM_PROMPT_PATH=/opt/wei/config/system_prompt.txt
WEI_LOG_DIR=/opt/wei/logs

# Email
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=replace-with-real-user
SMTP_PASSWORD=replace-with-real-password
SMTP_FROM=replace-with-real-from-address
