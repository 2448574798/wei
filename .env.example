APP_HOST=127.0.0.1
APP_PORT=8000

ONE_API_URL=http://127.0.0.1:3000/v1
ONE_API_TOKEN=replace-with-real-token

PLANNER_MODEL=gpt-4o-mini
AGENT_MODEL=gpt-4o
GROUNDED_ANSWER_MODEL=
ONLINE_RESEARCH_MODEL=gpt-4o-mini-search-preview

REDIS_URL=redis://127.0.0.1:6379/0
