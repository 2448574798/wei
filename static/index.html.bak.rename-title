<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover" />
    <title>AI 智能助手</title>

    <style>
        :root {
            --bg: #f3f6fb;
            --panel: rgba(255, 255, 255, 0.88);
            --panel-solid: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --border: rgba(148, 163, 184, 0.32);
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-soft: #dbeafe;
            --assistant: #f1f5f9;
            --assistant-border: #e2e8f0;
            --danger: #ef4444;
            --success: #16a34a;
            --shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
            --radius-xl: 28px;
            --radius-lg: 20px;
            --radius-md: 14px;
        }

        [data-theme="dark"] {
            --bg: #020617;
            --panel: rgba(15, 23, 42, 0.86);
            --panel-solid: #0f172a;
            --text: #e5e7eb;
            --muted: #94a3b8;
            --border: rgba(148, 163, 184, 0.26);
            --primary: #3b82f6;
            --primary-hover: #60a5fa;
            --primary-soft: rgba(59, 130, 246, 0.16);
            --assistant: #111827;
            --assistant-border: #1f2937;
            --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans SC", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(37, 99, 235, 0.16), transparent 34%),
                radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.14), transparent 32%),
                var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 18px;
        }

        .app {
            width: min(1100px, 100%);
            height: calc(100vh - 36px);
            display: grid;
            grid-template-rows: auto 1fr auto;
            gap: 14px;
        }

        .topbar {
            background: var(--panel);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
            border-radius: var(--radius-xl);
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .logo {
            width: 42px;
            height: 42px;
            border-radius: 15px;
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            display: grid;
            place-items: center;
            color: white;
            font-size: 22px;
            box-shadow: 0 10px 24px rgba(37, 99, 235, 0.28);
            flex: 0 0 auto;
        }

        .brand h1 {
            font-size: 18px;
            line-height: 1.2;
            margin: 0;
            white-space: nowrap;
        }

        .brand p {
            margin: 4px 0 0;
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* 改进后的下拉列表样式 */
        .select-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--panel-solid);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 6px 16px;
            transition: all 0.2s ease;
            min-height: 48px;
        }

        .select-wrap label {
            font-size: 14px;
            font-weight: 500;
            color: var(--muted);
            white-space: nowrap;
        }

        select {
            border: none;
            outline: none;
            background: transparent;
            color: var(--text);
            font-size: 15px;
            font-weight: 500;
            min-width: 160px;
            padding: 8px 0;
            cursor: pointer;
            /* 自定义箭头（深色主题自动反转） */
            appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
            background-repeat: no-repeat;
            background-position: right 8px center;
            background-size: 16px;
            padding-right: 28px;
        }

        /* 暗色主题下箭头颜色自适应 */
        [data-theme="dark"] select {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23e5e7eb' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        }

        .icon-btn {
            border: 1px solid var(--border);
            background: var(--panel-solid);
            color: var(--text);
            border-radius: 999px;
            height: 48px;
            padding: 0 16px;
            cursor: pointer;
            font-weight: 650;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: 0.18s ease;
            font-size: 14px;
        }

        .icon-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(37, 99, 235, 0.45);
            background: var(--primary-soft);
        }

        .chat-panel {
            min-height: 0;
            background: var(--panel);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
            border-radius: var(--radius-xl);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            scroll-behavior: smooth;
        }

        .empty {
            margin: auto;
            text-align: center;
            color: var(--muted);
            max-width: 560px;
            padding: 26px;
        }

        .empty .big {
            font-size: 44px;
            margin-bottom: 10px;
        }

        .empty h2 {
            color: var(--text);
            margin: 0 0 8px;
            font-size: 24px;
        }

        .message {
            display: flex;
            flex-direction: column;
            max-width: 85%;
            animation: slideIn 0.18s ease;
        }

        .message.user {
            align-self: flex-end;
        }

        .message.assistant {
            align-self: flex-start;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .bubble {
            border-radius: 22px;
            padding: 12px 16px;
            line-height: 1.65;
            word-break: break-word;
            white-space: pre-wrap;
            font-size: 15px;
        }

        .message.user .bubble {
            background: var(--primary);
            color: white;
            border-bottom-right-radius: 6px;
        }

        .message.assistant .bubble {
            background: var(--assistant);
            color: var(--text);
            border: 1px solid var(--assistant-border);
            border-bottom-left-radius: 6px;
        }

        .message.assistant .bubble.loading {
            padding: 6px 12px;
            font-size: 13px;
            background: var(--assistant);
            border: 1px solid var(--assistant-border);
            border-radius: 20px;
            border-bottom-left-radius: 6px;
            max-width: 160px;
        }

        .bubble pre {
            margin: 10px 0;
            padding: 12px;
            overflow-x: auto;
            border-radius: 14px;
            background: rgba(15, 23, 42, 0.92);
            color: #e5e7eb;
            white-space: pre;
        }

        .bubble code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            font-size: 0.92em;
        }

        .bubble p {
            margin: 0 0 10px;
        }

        .bubble p:last-child {
            margin-bottom: 0;
        }

        .bubble ul,
        .bubble ol {
            padding-left: 20px;
            margin: 8px 0;
        }

        .meta {
            color: var(--muted);
            font-size: 12px;
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .copy-btn {
            border: none;
            color: var(--muted);
            background: transparent;
            cursor: pointer;
            font-size: 12px;
            padding: 0;
        }

        .copy-btn:hover {
            color: var(--primary);
        }

        .typing {
            display: inline-flex;
            gap: 4px;
            align-items: center;
        }

        .dot {
            width: 6px;
            height: 6px;
            background: var(--muted);
            border-radius: 50%;
            animation: pulse 1s infinite ease-in-out;
        }

        .dot:nth-child(2) {
            animation-delay: 0.15s;
        }

        .dot:nth-child(3) {
            animation-delay: 0.3s;
        }

        @keyframes pulse {
            0%, 80%, 100% {
                transform: scale(0.6);
                opacity: 0.45;
            }
            40% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .composer {
            background: var(--panel);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
            border-radius: var(--radius-xl);
            padding: 12px;
        }

        .input-box {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            background: var(--panel-solid);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 8px 12px;
        }

        textarea {
            flex: 1;
            min-height: 40px;
            max-height: 180px;
            resize: none;
            border: none;
            outline: none;
            background: transparent;
            color: var(--text);
            font: inherit;
            line-height: 1.55;
            padding: 10px 0;
        }

        textarea::placeholder {
            color: var(--muted);
        }

        .send-btn {
            width: 44px;
            height: 44px;
            border-radius: 24px;
            border: none;
            background: var(--primary);
            color: white;
            font-size: 18px;
            cursor: pointer;
            display: grid;
            place-items: center;
            transition: 0.18s ease;
            flex: 0 0 auto;
        }

        .send-btn:hover:not(:disabled) {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

        .send-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .composer-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            color: var(--muted);
            font-size: 12px;
            padding: 8px 6px 0;
            flex-wrap: wrap;
        }

        .status {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--success);
        }

        .error {
            color: var(--danger);
        }

        /* 移动端适配 */
        @media (max-width: 720px) {
            body {
                padding: 8px;
            }

            .app {
                height: calc(100vh - 16px);
                gap: 8px;
            }

            .topbar {
                flex-direction: column;
                align-items: stretch;
                border-radius: 22px;
                gap: 12px;
            }

            .brand {
                justify-content: space-between;
            }

            .toolbar {
                width: 100%;
                justify-content: stretch;
                gap: 8px;
            }

            .select-wrap {
                flex: 1;
                justify-content: space-between;
                padding: 6px 14px;
                min-width: 0;
            }

            select {
                min-width: 0;
                width: auto;
                flex: 1;
                font-size: 14px;
            }

            .icon-btn {
                flex: 1;
                justify-content: center;
                height: 44px;
                font-size: 13px;
            }

            .chat-panel,
            .composer {
                border-radius: 22px;
            }

            .messages {
                padding: 16px;
            }

            .message {
                max-width: 90%;
            }

            .bubble {
                font-size: 14px;
                padding: 10px 14px;
            }

            .brand p {
                white-space: normal;
            }
        }
        /* mobile-select-optimized */

        @media (max-width: 720px) {
            html, body {
                width: 100%;
                height: 100%;
                overflow: hidden;
            }

            body {
                padding: 0;
                min-height: calc(var(--vh, 1vh) * 100);
                background:
                    radial-gradient(circle at top left, rgba(37, 99, 235, 0.16), transparent 34%),
                    var(--bg);
            }

            .app {
                width: 100%;
                height: calc(var(--vh, 1vh) * 100);
                min-height: calc(var(--vh, 1vh) * 100);
                grid-template-rows: auto 1fr auto;
                gap: 8px;
                padding: 8px;
            }

            .topbar {
                border-radius: 22px;
                padding: 12px;
                align-items: stretch;
                flex-direction: column;
                gap: 12px;
            }

            .brand {
                gap: 10px;
            }

            .logo {
                width: 38px;
                height: 38px;
                border-radius: 13px;
                font-size: 18px;
            }

            .brand h1 {
                font-size: 16px;
            }

            .brand p {
                font-size: 11px;
                white-space: normal;
                line-height: 1.35;
            }

            .toolbar {
                width: 100%;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .select-wrap {
                grid-column: 1 / -1;
                width: 100%;
                min-width: 0;
                border-radius: 16px;
                padding: 10px 40px 10px 13px;
            }

            select {
                min-width: 0;
                width: 100%;
                font-size: 14px;
            }

            .icon-btn {
                width: 100%;
                height: 38px;
                justify-content: center;
                border-radius: 15px;
                padding: 0 10px;
                font-size: 13px;
            }

            .chat-panel {
                min-height: 0;
                border-radius: 22px;
            }

            .messages {
                padding: 12px;
                gap: 14px;
                overscroll-behavior: contain;
            }

            .empty {
                padding: 16px 12px;
            }

            .empty .big {
                font-size: 36px;
            }

            .empty h2 {
                font-size: 20px;
            }

            .empty p {
                font-size: 13px;
                line-height: 1.6;
            }

            .message {
                gap: 8px;
            }

            .avatar {
                width: 30px;
                height: 30px;
                border-radius: 10px;
                font-size: 13px;
            }

            .bubble-wrap {
                max-width: calc(100% - 38px);
            }

            .bubble {
                font-size: 14px;
                line-height: 1.62;
                padding: 10px 12px;
                border-radius: 18px;
            }

            .message.user .bubble {
                border-bottom-right-radius: 6px;
            }

            .message.assistant .bubble {
                border-bottom-left-radius: 6px;
            }

            .meta {
                font-size: 11px;
            }

            .composer {
                border-radius: 22px;
                padding: 8px;
                padding-bottom: max(8px, env(safe-area-inset-bottom));
            }

            .input-box {
                border-radius: 20px;
                padding: 7px;
                gap: 7px;
            }

            textarea {
                min-height: 40px;
                max-height: 130px;
                font-size: 15px;
                padding: 8px 6px;
            }

            .send-btn {
                width: 42px;
                height: 40px;
                border-radius: 14px;
                font-size: 16px;
            }

            .composer-footer {
                font-size: 11px;
                padding: 6px 4px 0;
            }

            .status {
                max-width: 100%;
                overflow: hidden;
            }
        }

        @media (max-width: 390px) {
            .app {
                padding: 6px;
            }

            .topbar {
                padding: 10px;
            }

            .toolbar {
                gap: 6px;
            }

            .brand p {
                display: none;
            }

            .composer-footer {
                display: none;
            }

            .messages {
                padding: 10px;
            }

            .bubble {
                font-size: 13.5px;
            }
        }


        /* loading bubble compact fix */
        .message.assistant.loading-message {
            align-self: flex-start !important;
            max-width: none !important;
            width: auto !important;
        }

        .message.assistant.loading-message .bubble.loading {
            width: fit-content !important;
            max-width: 120px !important;
            min-width: 0 !important;
            padding: 5px 9px !important;
            font-size: 12px !important;
            line-height: 1 !important;
            border-radius: 14px !important;
            border-bottom-left-radius: 5px !important;
            white-space: nowrap !important;
        }

        .message.assistant.loading-message .typing {
            gap: 3px !important;
        }

        .message.assistant.loading-message .dot {
            width: 4px !important;
            height: 4px !important;
        }


        /* loading bubble same as single-line assistant bubble */
        .message.assistant.loading-message {
            align-self: flex-start !important;
            max-width: 85% !important;
            width: auto !important;
        }

        .message.assistant.loading-message .bubble.loading {
            display: inline-flex !important;
            align-items: center !important;
            width: auto !important;
            max-width: 85vw !important;
            min-width: 0 !important;
            padding: 10px 14px !important;
            font-size: 14px !important;
            line-height: 1.62 !important;
            border-radius: 18px !important;
            border-bottom-left-radius: 6px !important;
            white-space: nowrap !important;
            background: var(--assistant) !important;
            color: var(--text) !important;
            border: 1px solid var(--assistant-border) !important;
        }

        .message.assistant.loading-message .typing {
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
        }

        .message.assistant.loading-message .dot {
            width: 5px !important;
            height: 5px !important;
        }


        /* mobile send button fix */
        @media (max-width: 720px) {
            .input-box {
                align-items: flex-end !important;
                gap: 8px !important;
                padding: 8px !important;
            }

            textarea {
                min-width: 0 !important;
                flex: 1 1 auto !important;
                padding: 9px 6px !important;
                line-height: 1.45 !important;
            }

            .send-btn {
                flex: 0 0 42px !important;
                width: 42px !important;
                height: 42px !important;
                min-width: 42px !important;
                min-height: 42px !important;
                border-radius: 50% !important;
                padding: 0 !important;
                font-size: 16px !important;
                line-height: 1 !important;
                display: grid !important;
                place-items: center !important;
                align-self: flex-end !important;
                margin-bottom: 0 !important;
            }
        }

        @media (max-width: 390px) {
            .input-box {
                padding: 7px !important;
                gap: 7px !important;
            }

            .send-btn {
                flex-basis: 40px !important;
                width: 40px !important;
                height: 40px !important;
                min-width: 40px !important;
                min-height: 40px !important;
                font-size: 15px !important;
            }
        }


        /* custom model select */
        .model-picker {
            position: relative;
            padding: 6px;
            gap: 8px;
            overflow: visible;
        }

        .native-model-select {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            left: -9999px !important;
        }

        .model-trigger {
            border: none;
            background: transparent;
            color: var(--text);
            display: inline-flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            min-width: 190px;
            padding: 8px 8px;
            cursor: pointer;
            font: inherit;
            font-weight: 700;
            text-align: left;
        }

        .model-current {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .model-arrow {
            color: var(--muted);
            font-size: 18px;
            line-height: 1;
            transition: transform 0.18s ease;
        }

        .model-picker.open .model-arrow {
            transform: rotate(180deg);
        }

        .model-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            z-index: 50;
            width: 260px;
            padding: 8px;
            border-radius: 18px;
            background: var(--panel-solid);
            border: 1px solid var(--border);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
            display: none;
        }

        .model-picker.open .model-menu {
            display: grid;
            gap: 6px;
        }

        .model-option {
            width: 100%;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text);
            border-radius: 14px;
            padding: 10px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            text-align: left;
            transition: 0.16s ease;
        }

        .model-option:hover,
        .model-option.active {
            background: var(--primary-soft);
            border-color: rgba(37, 99, 235, 0.35);
        }

        .model-name {
            font-weight: 800;
            font-size: 14px;
        }

        .model-desc {
            color: var(--muted);
            font-size: 12px;
            white-space: nowrap;
        }

        @media (max-width: 720px) {
            .model-picker {
                padding: 8px 10px !important;
                display: grid !important;
                grid-template-columns: auto 1fr !important;
                align-items: center !important;
                gap: 8px !important;
            }

            .model-trigger {
                width: 100%;
                min-width: 0;
                padding: 7px 0;
            }

            .model-menu {
                left: 0;
                right: 0;
                width: 100%;
                top: calc(100% + 6px);
                border-radius: 18px;
                padding: 7px;
                box-shadow: 0 18px 42px rgba(15, 23, 42, 0.22);
            }

            .model-option {
                padding: 11px 12px;
                border-radius: 14px;
            }

            .model-name {
                font-size: 14px;
            }

            .model-desc {
                font-size: 11px;
            }
        }


        /* dropdown overlay fix */
        .topbar {
            position: relative !important;
            z-index: 1000 !important;
            overflow: visible !important;
        }

        .toolbar {
            position: relative !important;
            z-index: 1001 !important;
            overflow: visible !important;
        }

        .model-picker {
            position: relative !important;
            z-index: 1002 !important;
            overflow: visible !important;
        }

        .model-menu {
            z-index: 9999 !important;
        }

        .chat-panel {
            position: relative !important;
            z-index: 1 !important;
        }

        .app {
            overflow: visible !important;
        }

        @media (max-width: 720px) {
            .topbar {
                overflow: visible !important;
            }

            .toolbar {
                overflow: visible !important;
            }

            .model-picker {
                overflow: visible !important;
            }

            .model-menu {
                z-index: 9999 !important;
            }
        }


        /* empty state title style */
        .empty h2 {
            font-size: clamp(24px, 5vw, 42px) !important;
            line-height: 1.15 !important;
            font-weight: 800 !important;
            letter-spacing: -0.04em !important;
            margin: 0 !important;
            color: var(--text) !important;
            text-align: center !important;
        }

        .empty {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
        }

        @media (max-width: 720px) {
            .empty h2 {
                font-size: clamp(24px, 8vw, 34px) !important;
                line-height: 1.18 !important;
                max-width: 320px !important;
            }
        }


        /* empty h2 normal style */
        .empty h2 {
            font-weight: 500 !important;
            color: var(--text) !important;
            letter-spacing: -0.02em !important;
        }

        [data-theme="dark"] .empty h2 {
            color: #e5e7eb !important;
        }


        /* empty h2 lighter color */
        .empty h2 {
            color: #64748b !important;
            font-weight: 500 !important;
        }

        [data-theme="dark"] .empty h2 {
            color: #94a3b8 !important;
        }

    </style>
</head>

<body>
    <main class="app">
        <header class="topbar">
            <div class="brand">
                <div class="logo">AI</div>
                <div>
                    <h1>AI 智能助手</h1>
</div>
            </div>

            <div class="toolbar">
                <div class="select-wrap model-picker" id="modelPicker">
                    <label>模型</label>

                    <!-- 保留原 select 作为状态存储，避免影响现有 JS 的 modelSelect.value -->
                    <select id="modelSelect" class="native-model-select" aria-hidden="true" tabindex="-1">
                        <option value="gpt-4o-mini">GPT-4o-mini · 快速</option>
                        <option value="gpt-4o">GPT-4o · 标准</option>
                        <option value="gpt-5.4">GPT-5.4 · 均衡</option>
                        <option value="gpt-5.5">GPT-5.5 · 最强</option>
                    </select>

                    <button type="button" class="model-trigger" id="modelTrigger" aria-haspopup="listbox" aria-expanded="false">
                        <span class="model-current" id="modelCurrent">GPT-4o-mini · 快速</span>
                        <span class="model-arrow">⌄</span>
                    </button>

                    <div class="model-menu" id="modelMenu" role="listbox">
                        <button type="button" class="model-option" data-value="gpt-4o-mini">
                            <span class="model-name">GPT-4o-mini</span>
                            <span class="model-desc">快速 / 便宜</span>
                        </button>
                        <button type="button" class="model-option" data-value="gpt-4o">
                            <span class="model-name">GPT-4o</span>
                            <span class="model-desc">标准 / 多模态</span>
                        </button>
                        <button type="button" class="model-option" data-value="gpt-5.4">
                            <span class="model-name">GPT-5.4</span>
                            <span class="model-desc">均衡</span>
                        </button>
                        <button type="button" class="model-option" data-value="gpt-5.5">
                            <span class="model-name">GPT-5.5</span>
                            <span class="model-desc">最强</span>
                        </button>
                    </div>
                </div>

                <button class="icon-btn" id="themeBtn" title="切换主题">🌙 主题</button>
                <button class="icon-btn" id="clearBtn" title="清空对话">🗑️ 清空</button>
            </div>
        </header>

        <section class="chat-panel">
            <div class="messages" id="messages">
                <div class="empty" id="emptyState">
<h2>今天有什么想法？</h2>
</div>
            </div>
        </section>

        <footer class="composer">
            <div class="input-box">
                <textarea id="prompt" rows="1" placeholder="输入你的问题..."></textarea>
                <button class="send-btn" id="sendBtn" title="发送">➤</button>
            </div>

            <div class="composer-footer">
                <div class="status" id="status">
                    <span class="status-dot"></span>
                    <span>已连接 · 支持联网搜索</span>
                </div>
                <div>
                    <span id="charCount">0</span> 字 · 当前会保留上下文
                </div>
            </div>
        </footer>
    </main>

    <script>
        const messagesDiv = document.getElementById("messages");
        const emptyState = document.getElementById("emptyState");
        const promptInput = document.getElementById("prompt");
        const sendBtn = document.getElementById("sendBtn");
        const modelSelect = document.getElementById("modelSelect");
        const clearBtn = document.getElementById("clearBtn");
        const themeBtn = document.getElementById("themeBtn");
        const statusEl = document.getElementById("status");
        const charCount = document.getElementById("charCount");


        function setViewportHeight() {
            document.documentElement.style.setProperty("--vh", `${window.innerHeight * 0.01}px`);
        }

        setViewportHeight();
        window.addEventListener("resize", setViewportHeight);
        window.addEventListener("orientationchange", setViewportHeight);

        const STORAGE_KEY = "chat_ui_messages_v3";
        const MODEL_KEY = "chat_ui_model_v3";
        const THEME_KEY = "chat_ui_theme_v3";

        let chatHistory = [];
        let isSending = false;

        function nowTime() {
            const d = new Date();
            return d.toLocaleTimeString("zh-CN", {
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function escapeHtml(str) {
            return String(str)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function renderMarkdownLite(text) {
            let html = escapeHtml(text || "");

            html = html.replace(/```([\s\S]*?)```/g, (_, code) => {
                return `<pre><code>${code.trim()}</code></pre>`;
            });

            html = html.replace(/`([^`]+)`/g, "<code>$1</code>");

            html = html
                .split(/\n{2,}/)
                .map(block => {
                    const trimmed = block.trim();
                    if (!trimmed) return "";
                    if (trimmed.startsWith("<pre>")) return trimmed;
                    return `<p>${trimmed.replace(/\n/g, "<br>")}</p>`;
                })
                .join("");

            return html;
        }


        function getModelLabel(value) {
            const labels = {
                "gpt-4o-mini": "GPT-4o-mini · 快速",
                "gpt-4o": "GPT-4o · 标准",
                "gpt-5.4": "GPT-5.4 · 均衡",
                "gpt-5.5": "GPT-5.5 · 最强"
            };
            return labels[value] || value;
        }

        function syncModelPicker() {
            const current = document.getElementById("modelCurrent");
            const options = document.querySelectorAll(".model-option");
            if (!current) return;

            current.textContent = getModelLabel(modelSelect.value);

            options.forEach(btn => {
                btn.classList.toggle("active", btn.dataset.value === modelSelect.value);
            });
        }

        function setupModelPicker() {
            const picker = document.getElementById("modelPicker");
            const trigger = document.getElementById("modelTrigger");
            const menu = document.getElementById("modelMenu");

            if (!picker || !trigger || !menu) return;

            trigger.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = picker.classList.toggle("open");
                trigger.setAttribute("aria-expanded", String(isOpen));
            });

            document.querySelectorAll(".model-option").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    modelSelect.value = btn.dataset.value;
                    modelSelect.dispatchEvent(new Event("change"));
                    syncModelPicker();
                    picker.classList.remove("open");
                    trigger.setAttribute("aria-expanded", "false");
                });
            });

            document.addEventListener("click", () => {
                picker.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            });

            menu.addEventListener("click", (e) => {
                e.stopPropagation();
            });

            syncModelPicker();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(chatHistory));
            localStorage.setItem(MODEL_KEY, modelSelect.value);
        }

        function loadState() {
            const savedModel = localStorage.getItem(MODEL_KEY);
            if (savedModel) {
                modelSelect.value = savedModel;
            }

            const savedTheme = localStorage.getItem(THEME_KEY);
            if (savedTheme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
                themeBtn.textContent = "☀️ 主题";
            }

            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    chatHistory = JSON.parse(raw) || [];
                    chatHistory.forEach(m => addMessage(m.role, m.content, false));
                }
            } catch {
                chatHistory = [];
            }

            updateEmpty();
        }

        function updateEmpty() {
            emptyState.style.display = chatHistory.length ? "none" : "block";
        }

        function setStatus(text, type = "ok") {
            statusEl.innerHTML = `
                <span class="status-dot" style="background:${type === "error" ? "var(--danger)" : "var(--success)"}"></span>
                <span class="${type === "error" ? "error" : ""}">${text}</span>
            `;
        }

        function addMessage(role, content, save = true, meta = "") {
            updateEmpty();

            const msgDiv = document.createElement("div");
            msgDiv.className = `message ${role}`;

            const bubble = document.createElement("div");
            bubble.className = "bubble";
            bubble.innerHTML = renderMarkdownLite(content);

            const metaDiv = document.createElement("div");
            metaDiv.className = "meta";

            const time = document.createElement("span");
            time.textContent = meta || nowTime();

            const copyBtn = document.createElement("button");
            copyBtn.className = "copy-btn";
            copyBtn.textContent = "复制";
            copyBtn.addEventListener("click", async () => {
                await navigator.clipboard.writeText(content);
                copyBtn.textContent = "已复制";
                setTimeout(() => copyBtn.textContent = "复制", 1200);
            });

            metaDiv.appendChild(time);
            metaDiv.appendChild(copyBtn);

            msgDiv.appendChild(bubble);
            msgDiv.appendChild(metaDiv);
            messagesDiv.appendChild(msgDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;

            if (save) {
                chatHistory.push({ role, content });
                saveState();
            }

            updateEmpty();
            return msgDiv;
        }

        function addLoadingMessage() {
            updateEmpty();

            const msgDiv = document.createElement("div");
            msgDiv.className = "message assistant loading-message";
            msgDiv.id = "loading-" + Date.now();

            const bubble = document.createElement("div");
            bubble.className = "bubble loading";
            bubble.innerHTML = `
                <span class="typing">
                    <span>思考中</span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </span>
            `;

            msgDiv.appendChild(bubble);
            messagesDiv.appendChild(msgDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;

            return msgDiv;
        }

        function resizeInput() {
            promptInput.style.height = "auto";
            promptInput.style.height = Math.min(promptInput.scrollHeight, 180) + "px";
            charCount.textContent = promptInput.value.length;
        }

        async function sendMessage() {
            const userMessage = promptInput.value.trim();

            if (!userMessage || isSending) return;

            isSending = true;
            sendBtn.disabled = true;
            setStatus("正在请求模型...");

            promptInput.value = "";
            resizeInput();

            addMessage("user", userMessage);

            const loading = addLoadingMessage();
            const selectedModel = modelSelect.value;

            try {
                const payloadMessages = chatHistory
                    .filter(m => m.role === "user" || m.role === "assistant")
                    .slice(-12);

                const response = await fetch("/api/chat", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        model: selectedModel,
                        tool_choice: "auto",
                        messages: payloadMessages
                    })
                });

                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    throw new Error(data.error || `HTTP ${response.status}`);
                }

                const reply = data.reply || data.error || "无回复";

                loading.remove();

                const suffix = data.used_tool ? " · 已使用联网搜索" : "";
                addMessage("assistant", reply, true, nowTime() + suffix);

                setStatus(data.used_tool ? "回答完成 · 已使用联网搜索" : "回答完成");

            } catch (error) {
                loading.remove();

                const msg = `请求失败：${error.message}`;
                addMessage("assistant", msg);
                setStatus(msg, "error");

            } finally {
                isSending = false;
                sendBtn.disabled = false;
                promptInput.focus();
            }
        }

        sendBtn.addEventListener("click", sendMessage);

        promptInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        promptInput.addEventListener("input", resizeInput);

        modelSelect.addEventListener("change", () => {
            saveState();
            syncModelPicker();
        });

        clearBtn.addEventListener("click", () => {
            if (!confirm("确定要清空当前对话吗？")) return;

            chatHistory = [];
            localStorage.removeItem(STORAGE_KEY);

            [...messagesDiv.children].forEach(child => {
                if (child.id !== "emptyState") child.remove();
            });

            updateEmpty();
            setStatus("已清空对话");
        });

        themeBtn.addEventListener("click", () => {
            const current = document.documentElement.getAttribute("data-theme");

            if (current === "dark") {
                document.documentElement.removeAttribute("data-theme");
                localStorage.setItem(THEME_KEY, "light");
                themeBtn.textContent = "🌙 主题";
            } else {
                document.documentElement.setAttribute("data-theme", "dark");
                localStorage.setItem(THEME_KEY, "dark");
                themeBtn.textContent = "☀️ 主题";
            }
        });

        loadState();
        setupModelPicker();
        syncModelPicker();
        resizeInput();
        promptInput.focus();
    </script>
</body>
</html>
